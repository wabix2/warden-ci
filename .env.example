# GitHub App credentials (from https://github.com/settings/apps/your-app)
GITHUB_APP_ID=
# Paste the FULL contents of the downloaded .pem file, including the
# -----BEGIN RSA PRIVATE KEY----- / -----END RSA PRIVATE KEY----- lines.
GITHUB_PRIVATE_KEY=
# Set on the same GitHub App settings page (Webhook secret field). Required —
# without it, /api/github/webhooks rejects everything with 500, since there is
# no way to verify a request actually came from GitHub.
GITHUB_WEBHOOK_SECRET=

# --- Billing (Paddle) ---
PADDLE_API_KEY=
# Falls back to WEBHOOK_SECRET if PADDLE_WEBHOOK_SECRET isn't set, but set this one explicitly.
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=

# NOTE: this app currently has THREE plan tiers, each needing its own Price ID from
# the Paddle dashboard. If you only intend to sell one "Pro" plan, PADDLE_PRICE_TEAM
# and PADDLE_PRICE_ENTERPRISE can stay blank — but the Team/Enterprise buttons on the
# /subscribe page will show a "Configuration Error" alert if a customer clicks them.
PADDLE_PRICE_PRO=
PADDLE_PRICE_TEAM=
PADDLE_PRICE_ENTERPRISE=

# "sandbox" while testing, "production" once you've verified the full flow works with
# real (non-test) payment details. This MUST match whether PADDLE_CLIENT_TOKEN and the
# PADDLE_PRICE_* values above are sandbox or live credentials — a mismatch here is what
# causes Paddle's checkout overlay to fail with "something went wrong".
PADDLE_ENVIRONMENT=sandbox

# --- Billing data store (Upstash Redis, free tier) ---
# Required now — without these, billing state resets to nothing every time Render
# restarts the process (which happens on every free-tier spin-down from inactivity).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Detection corpus (point-1 differentiation — see src/telemetry/corpusLog.ts) ---
# Leave this "false" until PRIVACY.md's telemetry section has actually been reviewed
# and is true in practice — flipping this on is a legal decision, not just a config one.
WARDEN_TELEMETRY_ENABLED=false

PORT=3000

# Paddle requirement: all PADDLE_PRICE_* IDs must come from the SAME environment
# as PADDLE_CLIENT_TOKEN. Sandbox uses test_... client tokens; production uses live_...
PADDLE_CHECKOUT_ENABLED=true
WAITLIST_ADMIN_KEY=<god is loard he helped me in every action i did and in every step i take, thank you loard>

