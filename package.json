{
  "name": "warden-ci",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "test:webhook": "node scripts/test-webhook.mjs",
    "test:run-authorization": "pnpm build && node --test scripts/test-run-authorization.mjs",
    "test:popular": "pnpm build && node --test scripts/test-popular-packages.mjs",
    "test:package-risk": "pnpm build && node --test scripts/test-package-risk-signals.mjs",
    "test:corpus-privacy": "pnpm build && node --test scripts/test-corpus-privacy.mjs",
    "warden-scan": "node scripts/warden-scan.mjs",
    "db:ownership:report": "node scripts/backfill-run-ownership.mjs",
    "db:ownership:apply": "node scripts/backfill-run-ownership.mjs --apply",
    "test:ownership-backfill": "node --test scripts/test-ownership-backfill.mjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^7.2.2",
    "@octokit/rest": "^20.1.2",
    "@upstash/redis": "^1.38.4",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.3"
  }
}
