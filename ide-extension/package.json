{
  "name": "warden-check",
  "displayName": "Warden Check",
  "description": "Flags hallucinated/typosquat npm and PyPI package names as you type, before you commit them — the same detection Warden CI runs on pull requests, moved upstream to where the code is written.",
  "version": "0.1.0",
  "publisher": "REPLACE_ME",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Linters"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p ."
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  }
}
